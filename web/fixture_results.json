  "en": {
    "status": "fixture_validated",
    "language": "en",
    "primary": "The printed tax rate is one-quarter of one cent.\nThe proposed continuation lasts ten years.",
    "english": null,
    "originals": [
      {
        "text": "QUESTION # 1  \nShall Jackson County continue its anti-crime sales tax,  \ncommonly known as COMBAT, at the rate of one-quarter  \nof one cent for a period of ten years for the purpose of  \npromoting and providing public safety within Jackson  \nCounty, including the prevention and treatment of drug  \nabuse and addiction and the prevention, investigation,  \nprosecution, and detention of violent criminals and drug  \ndealers? The proceeds of this tax shall be deposited in a  \nspecial Jackson County Anti-Crime Sales Tax Trust  \nFund, separate from the general fund or any other county  \nfunds.  \nYES  \nNO",
        "language": "en",
        "authority": "Jackson County Election Board"
      }
    ],
    "speech": null
  },
